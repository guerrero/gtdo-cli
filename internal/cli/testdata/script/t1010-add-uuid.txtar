# Port of the date-on-add session with opt-in timestamp IDs. The default
# session first proves that add remains byte-for-byte legacy when UUIDs are
# disabled; the TOML file then enables IDs for creation and rewrite coverage.

env GTDO_TEST_NOW=2009-02-13T04:40:00.120Z
exec gtdo add legacy task
cmp stdout legacy.want

exec gtdo -d uuid.toml add '(a) priority task'
cmp stdout priority.want

exec gtdo -d uuid.toml addm eat apples
cmp stdout addm1.want

exec gtdo -d uuid.toml addm eat oranges
cmp stdout addm2.want

exec gtdo -d uuid.toml addm drink milk
cmp stdout addm3.want

env GTDO_TEST_NOW=2009-02-13T04:40:59.990Z
exec gtdo -d uuid.toml addm last second
cmp stdout rollover1.want

exec gtdo -d uuid.toml addm next second
cmp stdout rollover2.want

exec gtdo -pd uuid.toml list
cmp stdout list.want

exec gtdo -d uuid.toml append 2 today
cmp stdout edit.want

exec cat todo.txt
cmp stdout todo.want

# Retired date-on-add flags are unknown and fail before an action runs.
! exec gtdo -t list
cmp stdout unknown-t.want
! exec gtdo -T list
cmp stdout unknown-T.want

-- uuid.toml --
[behavior]
enable_uuid = true
-- legacy.want --
