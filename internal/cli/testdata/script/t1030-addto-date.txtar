# Port of t1030-addto-date.sh: the date-on-add feature for addto, via -t
# and via the config file (listfile parts belong to Task 8).

cp empty.txt garden.txt

exec gtdo -t addto garden.txt notice the daisies
cmp stdout d1.want

env GTDO_TEST_NOW=2009-02-14T04:40:00Z
exec gtdo -t addto garden.txt smell the roses
cmp stdout d2.want

env GTDO_TEST_NOW=2009-02-15T04:40:00Z
exec gtdo -t addto garden.txt mow the lawn
cmp stdout d3.want

env GTDO_TEST_NOW=2009-02-15T05:40:00Z
exec gtdo -d dateonadd.json addto garden.txt take out the trash
cmp stdout d4.want

exec cat garden.txt
cmp stdout dfile.want

-- dateonadd.json --
{"behaviour":{"dateOnAdd":true}}
-- d1.want --
1 2009-02-13 notice the daisies
GARDEN: 1 added.
-- d2.want --
2 2009-02-14 smell the roses
GARDEN: 2 added.
-- d3.want --
3 2009-02-15 mow the lawn
GARDEN: 3 added.
-- d4.want --
4 2009-02-15 take out the trash
GARDEN: 4 added.
-- dfile.want --
2009-02-13 notice the daisies
2009-02-14 smell the roses
2009-02-15 mow the lawn
2009-02-15 take out the trash
-- empty.txt --
