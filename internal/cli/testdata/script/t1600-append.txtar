# Port of t1600-append.sh: append functionality, including the
# SENTENCE_DELIMITERS config and the list sessions.

# the shell test seeds todo.txt with `todo.sh add notice the daisies > /dev/null`
cp daisies.txt todo.txt

! exec gtdo append adf asdfa
cmp stderr usage.want

! exec gtdo append 10 'hej!'
cmp stderr notask.want

exec gtdo append 1 'smell the roses'
cmp stdout a1.want

exec gtdo list
cmp stdout alist1.want

exec gtdo append 1 'see the wasps & bees'
cmp stdout a2.want

exec gtdo list
cmp stdout alist2.want

cp hay.txt todo.txt
exec gtdo append 1 'and notice the   three   spaces'
cmp stdout a3.want

cp four.txt todo.txt
exec gtdo append 1 '~@#$%^&*()-_=+[{]}|;:''',<.>/?
cmp stdout a4.want

exec gtdo append 2 '\`!\\"'
cmp stdout a5.want

exec gtdo list
cmp stdout alist3.want

# append of current sentence: no space before delimiters , ; and &
cp daisies.txt todo.txt
exec gtdo append 1 ', lilies and roses'
cmp stdout a6.want

exec gtdo append 1 '; see the wasps'
cmp stdout a7.want

exec gtdo append 1 '& bees'
cmp stdout a8.want

# custom SENTENCE_DELIMITERS via -d (the shell test appends the export to
# its todo.cfg; gtdo reads the JSON key)
exec gtdo -d delimiters.json append 1 '&beans'
cmp stdout a9.want

exec gtdo -d delimiters.json append 1 '%foo'
cmp stdout a10.want

exec gtdo -d delimiters.json append 1 '*2'
cmp stdout a11.want

-- usage.want --
usage: gtdo append NR "TEXT TO APPEND"
-- notask.want --
TODO: No task 10.
-- hay.txt --
jump on hay
-- four.txt --
smell the cows
grow some corn
thrash some hay
chase the chickens
-- daisies.txt --
notice the daisies
-- delimiters.json --
{"behaviour":{"sentenceDelimiters":"&%"}}
-- a1.want --
1 notice the daisies smell the roses
-- a2.want --
1 notice the daisies smell the roses see the wasps & bees
-- a3.want --
1 jump on hay and notice the   three   spaces
-- a4.want --
1 smell the cows ~@#$%^&*()-_=+[{]}|;:',<.>/?
-- a5.want --
2 grow some corn \`!\\"
-- alist1.want --
1 notice the daisies smell the roses
--
TODO: 1 of 1 tasks shown
-- alist2.want --
1 notice the daisies smell the roses see the wasps & bees
--
TODO: 1 of 1 tasks shown
-- alist3.want --
4 chase the chickens
2 grow some corn \`!\\"
1 smell the cows ~@#$%^&*()-_=+[{]}|;:',<.>/?
3 thrash some hay
--
TODO: 4 of 4 tasks shown
-- a6.want --
1 notice the daisies, lilies and roses
-- a7.want --
1 notice the daisies, lilies and roses; see the wasps
-- a8.want --
1 notice the daisies, lilies and roses; see the wasps & bees
-- a9.want --
1 notice the daisies, lilies and roses; see the wasps & bees&beans
-- a10.want --
1 notice the daisies, lilies and roses; see the wasps & bees&beans%foo
-- a11.want --
1 notice the daisies, lilies and roses; see the wasps & bees&beans%foo *2
