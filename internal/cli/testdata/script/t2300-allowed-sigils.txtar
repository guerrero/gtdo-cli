exec gtdo -p -d config.json list
stdout '1 existing @work [+]gtdo'
stdout '2 legacy @old [+]old'

cp todo.txt before-context.txt
! exec gtdo -d config.json add 'bad @home'
cmpenv stderr context.want
! stdout .
cmp todo.txt before-context.txt

exec gtdo -d config.json add 'good @work +gtdo'
cp todo.txt before-append.txt
! exec gtdo -d config.json append 1 '+other'
cmpenv stderr append.want
! stdout .
cmp todo.txt before-append.txt

! exec gtdo -d config.json addto inbox.txt 'new +other'
cmpenv stderr addto.want
! stdout .
cmp inbox.txt empty.txt

cp todo.txt before-batch.txt
! exec bash -c 'gtdo -d config.json addm $''batch @work\nbatch +other'''
cmpenv stderr batch.want
! stdout .
cmp todo.txt before-batch.txt

-- config.json --
{"dir":"$HOME","behaviour":{"allowedContexts":["@work"],"allowedProjects":["+gtdo"]}}

-- todo.txt --
existing @work +gtdo
legacy @old +old
-- empty.txt --
-- inbox.txt --
-- context.want --
TODO: Context "@home" is not allowed in $HOME/todo.txt at line 3.
-- append.want --
TODO: Project "+other" is not allowed in $HOME/todo.txt at line 1.
-- addto.want --
TODO: Project "+other" is not allowed in $HOME/inbox.txt at line 1.
-- batch.want --
TODO: Project "+other" is not allowed in $HOME/todo.txt at line 5.
