# Port of t1100-replace.sh: replace functionality, including the list
# sessions.

# the shell test seeds todo.txt with `todo.sh add notice the daisies > /dev/null`
cp daisies.txt todo.txt

! exec gtdo replace adf asdfa
cmp stderr usage.want

exec gtdo replace 1 'smell the cows'
cmp stdout r1.want

exec gtdo list
cmp stdout rlist1.want

exec gtdo replace 1 smell the roses
cmp stdout r2.want

exec gtdo list
cmp stdout rlist1b.want

# replace error: fresh four-task file
cp four.txt todo.txt
! exec gtdo replace 10 'hej!'
cmp stderr notask.want

exec gtdo replace 1 smell the cheese
cmp stdout r3.want

exec gtdo replace 3 jump on hay
cmp stdout r4.want

exec gtdo replace 4 collect the eggs
cmp stdout r5.want

# replace with priority
cp aprio.txt todo.txt
exec gtdo replace 1 'collect the bread'
cmp stdout r6.want

exec gtdo replace 1 collect the eggs
cmp stdout r7.want

# replace with &, spaces, symbols
cp hay.txt todo.txt
exec gtdo replace 1 'thrash the hay & thrash the wheat'
cmp stdout r8.want

cp hay.txt todo.txt
exec gtdo replace 1 'notice the   three   spaces'
cmp stdout r9.want

cp four.txt todo.txt
exec gtdo replace 1 '~@#$%^&*()-_=+[{]}|;:''',<.>/?
cmp stdout r10.want

exec gtdo replace 2 '\`!\\"'
cmp stdout r11.want

exec gtdo list
cmp stdout rlist2.want

# replace handling a legacy date prefix
cp date-seed.txt todo.txt

exec gtdo replace 1 this is just a new one
cmp stdout r14.want

exec gtdo replace 1 2010-07-04 this also has a new date
cmp stdout r15.want

# replace handling a legacy date prefix with a new priority
cp date-seed.txt todo.txt
exec gtdo replace 1 '(B) this also has a priority now'
cmp stdout r16.want

# replace handling priority and a legacy date prefix
cp date-seed.txt todo.txt
exec gtdo pri 1 A
cmp stdout r17.want

exec gtdo replace 1 this is just a new one
cmp stdout r18.want

# replace handling prepended priority and legacy date prefix
cp date-seed.txt todo.txt
exec gtdo replace 1 '(C) 2010-07-04 this also has a priority and new date'
cmp stdout r19.want

# replace with prepended date replaces existing date
cp aprio1.txt todo.txt
exec gtdo replace 1 2010-07-04 this also has a new date
cmp stdout r20.want

# replace with prepended priority replaces existing priority
cp aprio1.txt todo.txt
exec gtdo replace 1 '(B) this also has a new priority'
cmp stdout r21.want

# replace with prepended priority and date replaces existing date
cp dateonly.txt todo.txt
exec gtdo replace 1 '(B) 2010-07-04 this also has a new date'
cmp stdout r22.want

# replace with prepended priority and date replaces existing priority and date
cp aprio1.txt todo.txt
exec gtdo replace 1 '(B) 2010-07-04 this also has a new prio+date'
cmp stdout r23.want

