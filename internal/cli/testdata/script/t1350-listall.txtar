# Port of t1350-listall.sh: listall functionality, all sessions in scope.

cp todo5.txt todo.txt
cp done2.txt done.txt

# basic listall
exec gtdo -p listall
cmp stdout la1.want

# listall highlighting
exec gtdo listall
cmpenv stdout la2.want

# listall nonverbose
env TODOTXT_VERBOSE=0
exec gtdo -p listall
cmp stdout la3.want

# listall filtering
env TODOTXT_VERBOSE=1
exec gtdo -p listall @outside
cmp stdout la4.want

exec gtdo -p listall the
cmp stdout la5.want

exec gtdo -p listall breakfast
cmp stdout la6.want

exec gtdo -p listall doesnotmatch
cmp stdout la7.want

# listall number width
cp todo5.txt todo.txt
cp done6.txt done.txt
exec gtdo -p listall
cmp stdout la8.want

env TODOTXT_VERBOSE=0
exec gtdo add new task 1

exec gtdo add new task 2

exec gtdo add new task 3

exec gtdo add new task 4

exec gtdo add new task 5

env TODOTXT_VERBOSE=1
exec gtdo -p listall
cmp stdout la9.want

-- todo5.txt --
smell the uppercase Roses +flowers @outside
x 2011-08-08 tend the garden @outside
notice the sunflowers
x 2011-12-26 go outside +wakeup
(A) stop
-- done2.txt --
x 2011-12-01 eat breakfast
x 2011-12-05 smell the coffee +wakeup
-- done6.txt --
x 2010-01-01 old task 1
x 2010-01-01 old task 2
x 2010-01-01 old task 3
x 2010-01-01 old task 4
