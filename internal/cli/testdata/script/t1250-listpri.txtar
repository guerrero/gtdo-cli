# Port of t1250-listpri.sh: listpri functionality, all sessions in scope.

# basic listpri
cp pri3.txt todo.txt
exec gtdo listpri A
cmp stdout lsp1.want

exec gtdo -p listpri c
cmp stdout lsp2.want

# listpri highlighting
exec gtdo listpri
cmpenv stdout lsp3.want

# listpri filtering priorities
cp pri5.txt todo.txt
exec gtdo -p listpri
cmp stdout lsp4.want

exec gtdo -p listpri b
cmp stdout lsp5.want

exec gtdo -p listpri c
cmp stdout lsp6.want

exec gtdo -p listpri m
cmp stdout lsp7.want

exec gtdo -p listpri n
cmp stdout lsp8.want

# listpri filtering priority ranges
cp priaz.txt todo.txt
exec gtdo -p listpri a-c
cmp stdout lsp9.want

exec gtdo -p listpri c-Z
cmp stdout lsp10.want

exec gtdo -p listpri A-
cmp stdout lsp11.want

exec gtdo -p listpri A-C A-Z
cmp stdout lsp12.want

exec gtdo -p listpri X A-Z
cmp stdout lsp13.want

# concatenation of priorities and -ranges
exec gtdo -p listpri CX
cmp stdout lsp14.want

exec gtdo -p listpri ABR-Y
cmp stdout lsp15.want

exec gtdo -p listpri A-
cmp stdout lsp16.want

# listpri filtering of TERM
cp pri6.txt todo.txt
exec gtdo -p listpri 'should be'
cmp stdout lsp17.want

exec gtdo -p listpri a 'should be'
cmp stdout lsp18.want

exec gtdo -p listpri b second
cmp stdout lsp19.want

exec gtdo -p listpri x 'should be'
cmp stdout lsp20.want

-- pri3.txt --
(B) smell the uppercase Roses +flowers @outside
(C) notice the sunflowers
stop
-- pri5.txt --
(B) smell the uppercase Roses +flowers @outside
(C) notice the sunflowers
(m)others will notice this
(n) not a prioritized task
notice the (C)opyright
-- priaz.txt --
(B) smell the uppercase Roses +flowers @outside
(X) clean the house from A-Z
(C) notice the sunflowers
(X) listen to music
buy more records from artists A-Z
-- pri6.txt --
(B) ccc xxx this line should be third.
ccc xxx this line should be third.
(A) aaa zzz this line should be first.
aaa zzz this line should be first.
(B) bbb yyy this line should be second.
bbb yyy this line should be second.
-- lsp1.want --
