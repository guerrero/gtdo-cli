[!unix] skip 'requires Unix file permissions'

# A failure reading the second configured target leaves the first untouched.
chmod 0200 preflight-done.txt
! exec gtdo -d preflight.json format
stderr 'open preflight-done\.txt: permission denied'
chmod 0644 preflight-done.txt
cmp preflight-todo.txt preflight-todo.want
cmp preflight-done.txt preflight-done.want

-- preflight.json --
{"dir":".","files":{"todo":"preflight-todo.txt","done":"preflight-done.txt","report":"preflight-report.txt"}}
-- preflight-todo.txt --
@desk first task +work
-- preflight-todo.want --
@desk first task +work
-- preflight-done.txt --
@home second task +archive
-- preflight-done.want --
@home second task +archive
