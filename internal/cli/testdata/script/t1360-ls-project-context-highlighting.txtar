# Port of t1360-ls-project-context-highlighting.sh: project and context
# highlighting with custom COLOR_PROJECT/COLOR_CONTEXT (TOML in gtdo).

cp pri9.txt todo.txt
exec gtdo -d colors.toml ls
cmpenv stdout hl1.want

# -p disables the custom colors
exec gtdo -p -d colors.toml ls
cmp stdout hl2.want

# -@ hides contexts and their colors
exec gtdo -@ -d colors.toml ls
cmpenv stdout hl3.want

# -+ hides projects and their colors
exec gtdo -+ -d colors.toml ls
cmpenv stdout hl4.want

-- colors.toml --
[colors]
color_context = "\u001b[1m"
color_project = "\u001b[2m"
-- pri9.txt --
(A) prioritized @con01 context
(B) prioritized +prj02 project
(C) prioritized context at EOL @con03
(D) prioritized project at EOL +prj04
+prj05 non-prioritized project at BOL
@con06 non-prioritized context at BOL
multiple @con_ @texts and +pro_ +jects
non-contexts: seti@home @ @* @(foo)
non-projects: lost+found + +! +(bar)
-- hl1.want --
$ESC[1;33m1 (A) prioritized $ESC[1m@con01$ESC[0m$ESC[1;33m context$ESC[0m
$ESC[0;32m2 (B) prioritized $ESC[2m+prj02$ESC[0m$ESC[0;32m project$ESC[0m
$ESC[1;34m3 (C) prioritized context at EOL $ESC[1m@con03$ESC[0m$ESC[1;34m$ESC[0m
$ESC[1;37m4 (D) prioritized project at EOL $ESC[2m+prj04$ESC[0m$ESC[1;37m$ESC[0m
5 $ESC[2m+prj05$ESC[0m non-prioritized project at BOL
6 $ESC[1m@con06$ESC[0m non-prioritized context at BOL
7 multiple $ESC[1m@con_$ESC[0m $ESC[1m@texts$ESC[0m and $ESC[2m+pro_$ESC[0m $ESC[2m+jects$ESC[0m
8 non-contexts: seti@home @ @* @(foo)
9 non-projects: lost+found + +! +(bar)
