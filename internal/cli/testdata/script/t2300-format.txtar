# The default order rewrites both configured files and removes done dates.
exec gtdo format
cmpenv stdout default.stdout
cmp todo.txt default.todo
cmp done.txt default.done

# A custom template and an explicit relative file affect only that file.
exec gtdo -d custom.json format one.txt
cmpenv stdout custom.stdout
cmp one.txt custom.one
cmp todo.txt default.todo

# Quiet mode suppresses success messages while still rewriting successfully.
env TODOTXT_VERBOSE=0
exec gtdo -d custom.json format one.txt
stdout '^$'

# Explicit targets must exist and only one target argument is accepted.
! exec gtdo format missing.txt
stderr 'TODO: File .*missing.txt does not exist\.'
! exec gtdo format todo.txt done.txt
stderr '^usage: gtdo format \[FILE\]$'

# Invalid templates fail before any file is rewritten.
! exec gtdo -d invalid.json format
stderr '^invalid task format: unknown field "unknown"$'
cmp todo.txt default.todo

# An explicit configured target is validated before session setup can create it.
env TODOTXT_VERBOSE=1
! exec gtdo -d missing-configured.json format missing.txt
cmpenv stderr missing-configured.stderr
! exists missing-configured/missing.txt
! exists missing-configured/done.txt
! exists missing-configured/report.txt

# A configured directory reports the regular-file error without startup writes.
mkdir configured-directory
cp directory-child.want configured-directory/child.txt
! exec gtdo -d directory.json format configured-directory
cmpenv stderr directory.stderr
cmp configured-directory/child.txt directory-child.want
cmp directory-peer.txt directory-peer.want
! exists directory-report.txt

# An absolute explicit target is kept unchanged rather than joined to TODO_DIR.
exec gtdo -d absolute.json format $WORK/absolute.txt
cmpenv stdout absolute.stdout
cmp absolute.txt absolute.want

# Equal configured targets are formatted and reported only once.
exec gtdo -d dedupe.json format
cmp stdout dedupe.stdout
cmp same.txt same.want

-- todo.txt --
(B) write report key:one +work @desk 20260808T143045.12Z

plain item
-- done.txt --
x 2026-08-09 finish key:done +archive @desk 20260808T143045.12Z
-- default.stdout --
TODO: $HOME/todo.txt formatted.
TODO: $HOME/done.txt formatted.
-- default.todo --
(B) 20260808T143045.12Z write report key:one +work @desk

plain item
-- default.done --
x 20260808T143045.12Z finish key:done +archive @desk
-- custom.json --
{"dir":".","behaviour":{"taskFormat":"[project][content][keywords][context][uuid][priority][checked]"}}
-- one.txt --
x 2026-08-08 finish key:done +archive @desk 20260808T143045.12Z
-- custom.stdout --
TODO: $HOME/one.txt formatted.
-- custom.one --
+archive finish key:done @desk 20260808T143045.12Z x
-- invalid.json --
{"behaviour":{"taskFormat":"[unknown]"}}
-- missing-configured.json --
{"dir":"missing-configured","files":{"todo":"missing-configured/missing.txt"}}
-- missing-configured.stderr --
TODO: File $WORK/missing-configured/missing.txt does not exist.
-- directory.json --
{"dir":".","files":{"todo":"configured-directory","done":"directory-peer.txt","report":"directory-report.txt"}}
-- directory.stderr --
TODO: File $WORK/configured-directory is not a regular file.
-- directory-child.want --
leave directory contents alone
-- directory-peer.txt --
@desk leave peer +work
-- directory-peer.want --
@desk leave peer +work
-- absolute.json --
{"dir":"absolute-config"}
-- absolute.txt --
@desk absolute task +work
-- absolute.stdout --
TODO: $WORK/absolute.txt formatted.
-- absolute.want --
absolute task +work @desk
-- dedupe.json --
{"dir":".","files":{"todo":"same.txt","done":"same.txt","report":"same-report.txt"}}
-- same.txt --
@desk shared task +work
-- dedupe.stdout --
TODO: same.txt formatted.
-- same.want --
shared task +work @desk
