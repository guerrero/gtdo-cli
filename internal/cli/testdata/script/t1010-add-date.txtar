# Port of t1010-add-date.sh: the date-on-add feature via -t and via the
# config file, with the list sessions. The clock is pinned by
# GTDO_TEST_NOW (see script_test.go) and advanced with env, mirroring the
# shell suite's test_tick.

# cmd line first day
exec gtdo -t add notice the daisies
cmp stdout day1.want

exec gtdo list
cmp stdout list1.want

exec gtdo -pt add '(A) notice the daisies'
cmp stdout day1pri.want

exec gtdo -p list
cmp stdout list2.want

exec gtdo -npf del 2
cmp stdout day1del.want

exec gtdo -pt add '(b) notice the daisies'
cmp stdout day1lower.want

exec gtdo -p list
cmp stdout list3.want

exec gtdo -npf del 2
cmp stdout day1lowerdel.want

# cmd line second day
env GTDO_TEST_NOW=2009-02-14T04:40:00Z
exec gtdo -t add smell the roses
cmp stdout day2.want

exec gtdo list
cmp stdout list4.want

# cmd line third day
env GTDO_TEST_NOW=2009-02-15T04:40:00Z
exec gtdo -t add mow the lawn
cmp stdout day3.want

exec gtdo list
cmp stdout list5.want

# config file third day (the shell suite bumps the clock 3600s too)
env GTDO_TEST_NOW=2009-02-15T05:40:00Z
exec gtdo -d dateonadd.toml add take out the trash
cmp stdout day3cfg.want

exec gtdo list
cmp stdout list6.want

-- dateonadd.toml --
[behavior]
date_on_add = true
