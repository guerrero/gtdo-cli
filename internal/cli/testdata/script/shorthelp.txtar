# -h prints the short help: usage line, one-line action list, footer. Exit 0.
exec gtdo -h
cmp stdout shorthelp.want

# shorthelp also runs as an action, like todo.sh.
exec gtdo shorthelp
cmp stdout shorthelp.want

# -h discards every remaining argument, mirroring todo.sh's
# set -- '-h' 'shorthelp'.
exec gtdo -h -d config.json bogus
cmp stdout shorthelp.want

-- shorthelp.want --
  Usage: gtdo [-fhpanvV] [-d todo_config] action [task_number] [task_description]

  Actions:
    add  Add a TODO item to todo.txt.
    addm  Add multiple TODO items to todo.txt.
    addto  Add a line of text to a file in the todo.txt directory.
    append  Append text to the task on line NR.
    archive  Move done tasks from todo.txt to done.txt and remove blank lines.
    del  Delete the task on line NR, or remove TERM from it.
    depri  Remove the priority from the task(s) on line NR.
    do  Mark task(s) on line NR as done.
    format  Rewrite task files using the configured format.
    help  Display help about usage, options and built-in actions, or just the usage help for the passed ACTION(s).
    list  Display all tasks in todo.txt.
    listall  Display all the lines in todo.txt AND done.txt.
    listcon  List all the task contexts that start with the @ sign in todo.txt.
    listpri  Display all tasks prioritized PRIORITIES.
    listproj  List all the projects (terms that start with a + sign) in todo.txt.
    move  Move a task from one file to another in the todo.txt directory.
    prepend  Prepend text to the task on line NR.
    pri  Add or replace the priority of the task on line NR.
    replace  Replace the task on line NR.
    report  Add the number of open and done tasks to report.txt.
    shorthelp  List the one-line usage of all built-in actions.

  See "help" for more details.
