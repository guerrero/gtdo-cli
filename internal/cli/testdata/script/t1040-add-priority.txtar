# Port of t1040-add-priority.sh: the priority-on-add feature. The shell
# test appends to its config; gtdo uses two config files instead.

# normal use case
exec gtdo -d priority-a.json add take out the trash
cmp stdout ok.want

# wrong value in config var: startup die for any action
! exec gtdo -d priority-1.json add fail to take out the trash
cmp stderr wrong.want

! exec gtdo -d priority-1.json list
cmp stderr wrong.want

-- priority-a.json --
{"behaviour":{"priorityOnAdd":"A"}}
-- priority-1.json --
{"behaviour":{"priorityOnAdd":"1"}}
-- ok.want --
1 (A) take out the trash
TODO: 1 added.
-- wrong.want --
TODOTXT_PRIORITY_ON_ADD should be a capital letter from A to Z (it is now "1").
