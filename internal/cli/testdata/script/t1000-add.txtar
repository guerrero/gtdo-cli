# Port of t1000-addlist.sh: basic add functionality plus the list
# sessions (the original test interleaves them).

# basic add/list
exec gtdo add notice the daisies
cmp stdout basic1.want

exec gtdo list
cmp stdout list1.want

exec gtdo add smell the roses
cmp stdout basic2.want

exec gtdo list
cmp stdout list2.want

# basic list filtering
exec gtdo list daisies
cmp stdout list3.want

exec gtdo list smell
cmp stdout list4.want

# case-insensitive filtering
exec gtdo add 'smell the uppercase Roses'
cmp stdout basic3.want

exec gtdo list roses
cmp stdout list5.want

# add with symbols
exec gtdo add '~@#$%^&*()-_=+[{]}|;:''',<.>/?
cmp stdout sym1.want

exec gtdo add '\`!\\"'
cmp stdout sym2.want

exec gtdo list
cmp stdout list6.want

# advanced add: fresh file
rm todo.txt
exec gtdo add 'notice the   three   spaces'
cmp stdout adv1.want

exec gtdo add notice how the   spaces    get lost
cmp stdout adv2.want

exec gtdo list
cmp stdout list7.want

# add with CR: the CR byte is squashed to a space (cleaninput); fed via
# stdin because a txtar command line cannot carry the byte.
rm todo.txt
stdin cr.txt
exec gtdo add
cmp stdout cr.want

exec gtdo list
cmp stdout list8.want

