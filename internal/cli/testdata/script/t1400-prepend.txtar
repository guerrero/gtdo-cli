# Port of t1400-prepend.sh: prepend functionality, including the list
# sessions.

! exec gtdo prepend B B
cmp stderr usage.want

cp pre3.txt todo.txt
exec gtdo list
cmpenv stdout prelist1.want

exec gtdo -p list
cmp stdout prelist2.want

exec gtdo prepend 2 test
cmp stdout p1.want

exec gtdo prepend 1 test
cmp stdout p2.want

exec gtdo prepend 3 'no running & jumping now'
cmp stdout p3.want

cp hay.txt todo.txt
exec gtdo prepend 1 'notice the   three   spaces and'
cmp stdout p4.want

cp pre4.txt todo.txt
exec gtdo prepend 1 '~@#$%^&*()-_=+[{]}|;:''',<.>/?
cmp stdout p5.want

exec gtdo prepend 2 '\`!\\"'
cmp stdout p6.want

exec gtdo list
cmp stdout prelist3.want

# prepend handling a legacy date prefix
cp date-seed.txt todo.txt
exec gtdo prepend 1 'this is just a'
cmp stdout p7.want

# prepend handling priority and a legacy date prefix
cp date-seed.txt todo.txt
exec gtdo pri 1 A
exec gtdo prepend 1 'this is just a'
cmp stdout p8.want

# prepend with a legacy date prefix keeps both
cp date-seed.txt todo.txt
exec gtdo prepend 1 '2010-07-04 this is just a'
cmp stdout p9.want

-- usage.want --
usage: gtdo prepend NR "TEXT TO PREPEND"
-- pre3.txt --
(B) smell the uppercase Roses +flowers @outside
notice the sunflowers
stop
-- pre4.txt --
smell the cows
grow some corn
thrash some hay
chase the chickens
-- hay.txt --
jump on hay
-- date-seed.txt --
2009-02-13 new task
-- p1.want --
2 test notice the sunflowers
-- p2.want --
1 (B) test smell the uppercase Roses +flowers @outside
-- p3.want --
3 no running & jumping now stop
-- p4.want --
1 notice the   three   spaces and jump on hay
-- p5.want --
1 ~@#$%^&*()-_=+[{]}|;:',<.>/? smell the cows
-- p6.want --
2 \`!\\" grow some corn
-- prelist1.want --
$ESC[0;32m1 (B) smell the uppercase Roses +flowers @outside$ESC[0m
2 notice the sunflowers
3 stop
--
TODO: 3 of 3 tasks shown
-- prelist2.want --
1 (B) smell the uppercase Roses +flowers @outside
2 notice the sunflowers
3 stop
--
TODO: 3 of 3 tasks shown
-- prelist3.want --
4 chase the chickens
3 thrash some hay
2 \`!\\" grow some corn
1 ~@#$%^&*()-_=+[{]}|;:',<.>/? smell the cows
--
TODO: 4 of 4 tasks shown
-- p7.want --
1 2009-02-13 this is just a new task
-- p8.want --
1 (A) 2009-02-13 this is just a new task
-- p9.want --
1 2009-02-13 2010-07-04 this is just a new task
